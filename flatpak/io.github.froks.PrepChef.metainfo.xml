<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.froks.PrepChef</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>PrepChef</name>
  <summary>Wochenpläne fürs Meal-Prep</summary>
  <developer id="io.github.froks">
    <name>froks</name>
  </developer>
  <description>
    <p>
      PrepChef plant deine Meal-Prep-Woche: Es wählt Gerichte, die gut zusammenpassen, schreibt eine
      zusammengefasste Einkaufsliste und plant den Kochtag so, dass Ofen und Herd parallel arbeiten.
    </p>
    <ul>
      <li>Wochenplan nach Personen, Kalorienziel, Ernährungsform und Haltbarkeit</li>
      <li>Einkaufsliste nach Supermarkt-Bereichen, abhakbar</li>
      <li>Prep-Ablauf mit Uhrzeiten – passive Schritte laufen nebenbei</li>
      <li>Nährwerte pro Tag und Person</li>
      <li>Über 90 Grundrezepte, eigene Rezepte und Import per URL (z. B. Chefkoch)</li>
      <li>Präferenzen: schnell fertig, wenig Aufwand, Low Carb</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.froks.PrepChef.desktop</launchable>
  <url type="homepage">https://github.com/froks/prepchef</url>
  <url type="bugtracker">https://github.com/froks/prepchef/issues</url>
  <categories>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>Meal Prep</keyword>
    <keyword>Rezepte</keyword>
    <keyword>Einkaufsliste</keyword>
  </keywords>
