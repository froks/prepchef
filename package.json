{
  "name": "prepchef",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "desktop"
  ],
  "scripts": {
    "dev": "bun run --filter '@prepchef/*' dev",
    "build": "bun run --filter @prepchef/client build",
    "start": "bun run --filter @prepchef/server start",
    "test": "bun run --filter @prepchef/server test",
    "typecheck": "bun run --filter '@prepchef/*' typecheck",
    "package": "bun scripts/package.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "app": "bun scripts/package.ts --run",
    "smoke-test": "bun scripts/smoke-test.ts"
  }
}
